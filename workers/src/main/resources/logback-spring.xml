<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <!--
    pi / jobKey lấy từ MDC (JobMdc). Ngoài lúc xử lý job MDC rỗng → %replace xóa chuỗi " pi= jobKey="
    để dòng log thường không bị dính phần rỗng.
  -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%clr(%d{HH:mm:ss.SSS}){faint} %clr([%thread]){faint} %clr(%-5level){} %clr(%logger{36}){cyan}%clr(%replace( pi=%X{pi} jobKey=%X{jobKey}){'^ pi= jobKey=$', ''}){magenta} %clr(-){faint} %msg%n</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>

</configuration>
